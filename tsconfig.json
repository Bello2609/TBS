{
  "compilerOptions": {
    "target": "ES2020",                         // More modern target for both frontend & backend
    "module": "commonjs",                       // Recommended for Node.js backend
    "moduleResolution": "node",
    "jsx": "react-jsx",                         // Required for React 17+
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,                 // Useful for importing JSON
    "baseUrl": ".",                            // Root base path
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"],
      "@pages/*": ["src/pages/*"],
      "@hooks/*": ["src/hooks/*"],
      "@context/*": ["src/context/*"],
      "@utils/*": ["src/utils/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": ["src", "backend"],
  "exclude": ["node_modules", "dist"]
}
